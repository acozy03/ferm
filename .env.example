# Core application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# VERCEL_URL is supplied automatically when deploying on Vercel.
# VERCEL_URL=
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI providers and encrypted user-key storage
OPENAI_API_KEY=
AI_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3

# Email delivery
RESEND_API_KEY=
FOLLOW_UP_FROM_EMAIL=
CONTACT_FROM_EMAIL=
FOLLOW_UP_ALLOWED_DOMAINS=

# Rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# API and browser-extension access
ALLOWED_ORIGINS=http://localhost:3000
CHECK_EMAIL_API_SECRET=

# Job-board scraping safeguards
JOB_BOARD_ALLOWLIST=true
JOB_BOARD_ALLOWLIST_HOSTS=
